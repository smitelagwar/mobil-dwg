{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smitelagwar/mobil-dwg/fixtures/manifest/schema.json",
  "title": "mobil-dwg fixture manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "generated_on",
    "sources",
    "rights_profiles",
    "fixtures",
    "negative_derivations",
    "coverage_requirements"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_on": { "type": "string", "format": "date" },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "revision", "license", "redistribution", "provenance"]
      }
    },
    "rights_profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["license", "redistribution", "provenance"]
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "corpus", "role", "format", "acad_version", "version_family", "storage", "size_bytes", "hash", "features", "expected", "golden"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
          "corpus": { "enum": ["public", "synthetic", "private"] },
          "role": { "enum": ["positive", "negative"] },
          "format": { "enum": ["dwg", "dxf"] },
          "acad_version": { "type": "string", "pattern": "^AC[0-9]{4}$" },
          "version_family": { "type": "string", "minLength": 1 },
          "storage": {
            "type": "object",
            "required": ["mode", "path"],
            "properties": {
              "mode": { "enum": ["remote-pinned", "committed", "private-local"] },
              "path": { "type": "string", "minLength": 1 },
              "source": { "type": "string" },
              "rights_profile": { "type": "string" }
            }
          },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "hash": {
            "type": "object",
            "required": ["algorithm", "value"],
            "properties": {
              "algorithm": { "enum": ["sha256", "git-blob-sha1"] },
              "value": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }
            }
          },
          "features": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "expected": { "type": "object", "required": ["open_result", "entity_counts", "warnings"] },
          "golden": { "type": "object", "required": ["semantic", "image_status", "redistribution"] }
        }
      }
    },
    "negative_derivations": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "source_id", "transform", "expected"] }
    },
    "coverage_requirements": { "type": "object" },
    "upstream_reference_evidence": { "type": "object" }
  }
}
