<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Production candidates: strict exact versions only. NuGet exact-range syntax is intentional. -->
    <PackageVersion Include="ACadSharp" Version="[3.7.1]" />
    <PackageVersion Include="SkiaSharp" Version="[4.151.1]" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="[10.0.100]" />

    <!-- Test/CI-only packages; never production runtime dependencies. -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="[4.151.1]" />
    <PackageVersion Include="IxMilia.Dxf" Version="[0.8.4]" />
  </ItemGroup>
</Project>
