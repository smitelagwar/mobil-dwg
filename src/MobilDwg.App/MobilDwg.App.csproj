<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MobilDwg.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>Mobil DWG</ApplicationTitle>
    <ApplicationId>com.smitelagwar.mobildwg</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidFastDeploymentType>None</AndroidFastDeploymentType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MobilDwg.Core/MobilDwg.Core.csproj" />
    <ProjectReference Include="../MobilDwg.Cad/MobilDwg.Cad.csproj" />
    <ProjectReference Include="../MobilDwg.Rendering/MobilDwg.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#1565C0" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#0B1220" BaseSize="128,128" />
  </ItemGroup>
</Project>
