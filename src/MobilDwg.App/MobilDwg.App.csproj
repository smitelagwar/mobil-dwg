<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MobilDwg.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>Mobil DWG</ApplicationTitle>
    <ApplicationId>com.smitelagwar.mobildwg</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <TargetSdkVersion>36</TargetSdkVersion>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidEnableSGenConcurrent>true</AndroidEnableSGenConcurrent>
  </PropertyGroup>

  <PropertyGroup Condition="'$(V05Validation)' == 'true'">
    <DefineConstants>$(DefineConstants);V05_VALIDATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(V06Validation)' == 'true'">
    <DefineConstants>$(DefineConstants);V06_VALIDATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(A10Validation)' == 'true'">
    <DefineConstants>$(DefineConstants);A10_VALIDATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(A11Validation)' == 'true'">
    <DefineConstants>$(DefineConstants);A11_VALIDATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(A12Validation)' == 'true'">
    <DefineConstants>$(DefineConstants);A12_VALIDATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(A13Validation)' == 'true'">
    <DefineConstants>$(DefineConstants);A13_VALIDATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(A14Validation)' == 'true'">
    <DefineConstants>$(DefineConstants);A14_VALIDATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(A15Validation)' == 'true'">
    <DefineConstants>$(DefineConstants);A15_VALIDATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(A16Validation)' == 'true'">
    <DefineConstants>$(DefineConstants);A16_VALIDATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(A17Validation)' == 'true'">
    <DefineConstants>$(DefineConstants);A17_VALIDATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(A18Validation)' == 'true'">
    <DefineConstants>$(DefineConstants);A18_VALIDATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(A19Validation)' == 'true'">
    <DefineConstants>$(DefineConstants);A19_VALIDATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(A20Validation)' == 'true'">
    <DefineConstants>$(DefineConstants);A20_VALIDATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(A21Validation)' == 'true'">
    <DefineConstants>$(DefineConstants);A21_VALIDATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(A22Validation)' == 'true'">
    <DefineConstants>$(DefineConstants);A22_VALIDATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(A25Validation)' == 'true'">
    <DefineConstants>$(DefineConstants);A25_VALIDATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(A26Validation)' == 'true'">
    <DefineConstants>$(DefineConstants);A26_VALIDATION</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(A21Validation)' == 'true'">
    <MauiAsset Include="../../fixtures/public/synthetic/synthetic_turkish_basic_ac1015.dxf" LogicalName="a21_turkish.dxf" />
    <MauiAsset Include="../../fixtures/public/synthetic/negative_missing_font_ac1015.dxf" LogicalName="a21_missing_font.dxf" />
    <MauiAsset Include="../../fixtures/public/synthetic/negative_missing_xref_ac1015.dxf" LogicalName="a21_missing_xref.dxf" />
    <MauiAsset Include="$(A21GeneratedDwgPath)" LogicalName="a21_synthetic.dwg" Condition="'$(A21GeneratedDwgPath)' != '' and Exists('$(A21GeneratedDwgPath)')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MobilDwg.Core/MobilDwg.Core.csproj" />
    <ProjectReference Include="../MobilDwg.Cad/MobilDwg.Cad.csproj" />
    <ProjectReference Include="../MobilDwg.Rendering/MobilDwg.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#1565C0" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#0B1220" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <AndroidEnvironment Include="Platforms\Android\environment.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(V05Validation)' == 'true'">
    <MauiAsset Include="../../fixtures/public/synthetic/synthetic_turkish_basic_ac1015.dxf" LogicalName="v05_positive.dxf" />
    <MauiAsset Include="../../fixtures/public/synthetic/negative_missing_font_ac1015.dxf" LogicalName="v05_missing_font.dxf" />
    <MauiAsset Include="../../fixtures/public/synthetic/negative_missing_xref_ac1015.dxf" LogicalName="v05_missing_xref.dxf" />
    <MauiAsset Include="$(V05GeneratedDwgPath)" LogicalName="v05_positive.dwg" Condition="'$(V05GeneratedDwgPath)' != '' and Exists('$(V05GeneratedDwgPath)')" />
  </ItemGroup>

  <Target Name="ValidateV05GeneratedDwgInput" BeforeTargets="Build" Condition="'$(V05Validation)' == 'true'">
    <Error Condition="'$(V05GeneratedDwgPath)' == ''" Text="V05Validation requires V05GeneratedDwgPath." />
    <Error Condition="!Exists('$(V05GeneratedDwgPath)')" Text="V05 generated DWG input does not exist: $(V05GeneratedDwgPath)" />
  </Target>
</Project>
