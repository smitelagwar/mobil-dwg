    safe-open sources instead of changing the production app target framework.
    The V06 Android gate separately exercises these sources inside the real APK.
  -->
  <ItemGroup>
    <Compile Include="../../src/MobilDwg.App/Opening/CadFileOpenContracts.cs" Link="ProductionOpening/CadFileOpenContracts.cs" />
    <Compile Include="../../src/MobilDwg.App/Opening/CadFileOpenCoordinator.cs" Link="ProductionOpening/CadFileOpenCoordinator.cs" />
    <Compile Include="../../src/MobilDwg.App/Opening/SafeCadFileCache.cs" Link="ProductionOpening/SafeCadFileCache.cs" />
